/*
 * M4 memory map, all in regions Linux reserves for the M4
 * (remoteproc carveouts):
 *
 *   0x00000000  RETRAM     1K  vector table (CONFIG_ROMSTART_RELOCATION_ROM)
 *   0x00000400  RETRAM    63K  more code, placed with zephyr_code_relocate()
 *   0x10000000  SRAM1    128K  code, rodata, resource table (zephyr,flash)
 *   0x10020000  SRAM2    128K  data, bss, stacks, heaps (zephyr,sram)
 *   0x10040000  SRAM3     64K  rpmsg vrings and buffers (zephyr,ipc_shm)
 *
 * Same split as ST's Cube M4 examples. Keeping code and data in separate
 * regions lets the MPU map code read-only and data execute-never, and
 * keeps the resource table out of RAM that the heap may claim.
 */

#include <zephyr/dt-bindings/sensor/lsm6dso.h>

/delete-node/ &mcusram;
/delete-node/ &retram;

/ {
	chosen {
		zephyr,flash = &mcusram1;
		zephyr,sram = &mcusram2;
		/*
		 * shared memory reserved for the inter-processor communication
		 */
		zephyr,ipc_shm = &mcusram3;
		zephyr,ipc = &mailbox;
	};

	/*
	 * RETRAM after the 1 KB vector table region, as a linker memory
	 * region named RETRAM (CMakeLists.txt relocates code into it).
	 * remoteproc loads it like any other ELF segment, so the code is
	 * linked in place (NOCOPY), nothing is copied at boot.
	 */
	retram: memory@400 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x00000400 DT_SIZE_K(63)>;
		zephyr,memory-region = "RETRAM";
	};

	mcusram1: memory@10000000 {
		compatible = "mmio-sram";
		reg = <0x10000000 DT_SIZE_K(128)>;
	};

	mcusram2: memory@10020000 {
		compatible = "mmio-sram";
		reg = <0x10020000 DT_SIZE_K(128)>;
	};

	mcusram3: memory@10040000 {
		compatible = "mmio-sram";
		reg = <0x10040000 DT_SIZE_K(64)>;
	};
};

/*
 * The board defaults enable these; nothing on the M4 uses a UART (the
 * console is the RAM console), so don't set them up or claim their pins
 * (USART3 PB10/PB12, UART7 PE7/PE8).
 */
&usart3 {
	status = "disabled";
};

&uart7 {
	status = "disabled";
};

/*
 * IMU: Arduino Modulino Movement (ST LSM6DSOX) on SPI5, GPIO expansion
 * header CN2 (docs/hardware.md in DontFall). CS on PF6 as a plain GPIO:
 * the chip stays in I2C mode until CS goes low, so it must be driven.
 * Linux leaves spi5 disabled, the M4 owns it.
 */
&spi5 {
	pinctrl-0 = <&spi5_sck_pf7 &spi5_miso_pf8 &spi5_mosi_pf9>;
	cs-gpios = <&gpiof 6 GPIO_ACTIVE_LOW>;

	imu: lsm6dsox@0 {
		compatible = "st,lsm6dso";
		reg = <0>;
		/* 64 MHz kernel clock / 8 = 8 MHz (chip max 10 MHz) */
		spi-max-frequency = <DT_FREQ_M(10)>;
		/* The driver writes these at boot; without them the chip stays
		 * powered down (ODR off).
		 */
		accel-odr = <LSM6DSO_DT_ODR_833Hz>;
		accel-range = <LSM6DSO_DT_FS_4G>;
		gyro-odr = <LSM6DSO_DT_ODR_833Hz>;
		gyro-range = <LSM6DSO_DT_FS_500DPS>;
		/* Data ready on INT1 (PF3, EXTI3). Pulsed, not latched: the
		 * driver masks the GPIO interrupt while it reads, and a latched
		 * line that goes high in that window never makes another edge.
		 * Pulsed only loses that one sample.
		 */
		irq-gpios = <&gpiof 3 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
		drdy-pulsed;
	};
};

/* M4 watchdog (src/wdog.c). Its reset is the EXTI 68 event Linux's
 * remoteproc reports as a crash.
 */
&wwdg1 {
	status = "okay";
};
