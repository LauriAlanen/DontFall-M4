/*
 * M4 memory map, all in regions Linux reserves for the M4
 * (remoteproc carveouts):
 *
 *   0x00000000  RETRAM   vector table only (CONFIG_ROMSTART_RELOCATION_ROM)
 *   0x10000000  SRAM1    128K  code, rodata, resource table (zephyr,flash)
 *   0x10020000  SRAM2    128K  data, bss, stacks, heaps (zephyr,sram)
 *   0x10040000  SRAM3     64K  rpmsg vrings and buffers (zephyr,ipc_shm)
 *
 * Same split as ST's Cube M4 examples. Keeping code and data in separate
 * regions lets the MPU map code read-only and data execute-never, and
 * keeps the resource table out of RAM that the heap may claim.
 */

/delete-node/ &mcusram;

/ {
	chosen {
		zephyr,flash = &mcusram1;
		zephyr,sram = &mcusram2;
		/*
		 * shared memory reserved for the inter-processor communication
		 */
		zephyr,ipc_shm = &mcusram3;
		zephyr,ipc = &mailbox;
	};

	mcusram1: memory@10000000 {
		compatible = "mmio-sram";
		reg = <0x10000000 DT_SIZE_K(128)>;
	};

	mcusram2: memory@10020000 {
		compatible = "mmio-sram";
		reg = <0x10020000 DT_SIZE_K(128)>;
	};

	mcusram3: memory@10040000 {
		compatible = "mmio-sram";
		reg = <0x10040000 DT_SIZE_K(64)>;
	};
};
