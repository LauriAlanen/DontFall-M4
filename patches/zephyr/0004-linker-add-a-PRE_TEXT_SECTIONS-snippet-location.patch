From: Lauri Alanen <laurialanen1@gmail.com>
Subject: [PATCH] linker: add a PRE_TEXT_SECTIONS snippet location (Cortex-M)

ld puts an input section into the first output section in the script
whose pattern matches, and the text section's *(.text.*) comes before
every existing snippet location that may define output sections. So a
snippet can't move a library's code into another memory region.
PRE_TEXT_SECTIONS is included right before the text section.

DontFall uses it to link the prebuilt libmicroros.a into the M4's
RETRAM.
---
 cmake/modules/extensions.cmake                     | 14 ++++++++++++--
 include/zephyr/arch/arm/cortex_m/scripts/linker.ld |  7 +++++++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/cmake/modules/extensions.cmake b/cmake/modules/extensions.cmake
index d9129532..ce4edfa7 100644
--- a/cmake/modules/extensions.cmake
+++ b/cmake/modules/extensions.cmake
@@ -1182,6 +1182,11 @@ endfunction(zephyr_check_compiler_flag_hardcoded)
 #    ROM_START     Inside the first output section of the image. This option is
 #                  currently only available on ARM Cortex-M, ARM Cortex-R,
 #                  x86, ARC, openisa_rv32m1, and RISC-V.
+#    PRE_TEXT_SECTIONS
+#                  Own output sections before the text section, e.g. to place
+#                  a library's code in another region. Its input patterns take
+#                  precedence over the generic ones of the text section. This
+#                  option is currently only available on ARM Cortex-M.
 #    ROM_SECTIONS  Inside the ROMABLE_REGION GROUP, not initialized.
 #    RAM_SECTIONS  Inside the RAMABLE_REGION GROUP, not initialized.
 #    DATA_SECTIONS Inside the RAMABLE_REGION GROUP, initialized.
@@ -1211,8 +1216,9 @@ endfunction(zephyr_check_compiler_flag_hardcoded)
 #    _mysection_end = .;
 #    _mysection_size = ABSOLUTE(_mysection_end - _mysection_start);
 #
-# When placing into SECTIONS, ROM_SECTIONS, RAM_SECTIONS or DATA_SECTIONS, the
-# files must instead define their own output sections to achieve the same thing:
+# When placing into SECTIONS, PRE_TEXT_SECTIONS, ROM_SECTIONS, RAM_SECTIONS or
+# DATA_SECTIONS, the files must instead define their own output sections to
+# achieve the same thing:
 #    SECTION_PROLOGUE(.mysection,,)
 #    {
 #        _mysection_start = .;
@@ -1236,6 +1242,7 @@ function(zephyr_linker_sources location)
   set(ram_sections_path  "${snippet_base}/snippets-ram-sections.ld")
   set(data_sections_path "${snippet_base}/snippets-data-sections.ld")
   set(rom_start_path     "${snippet_base}/snippets-rom-start.ld")
+  set(pre_text_sections_path "${snippet_base}/snippets-pre-text-sections.ld")
   set(noinit_path        "${snippet_base}/snippets-noinit.ld")
   set(rwdata_path        "${snippet_base}/snippets-rwdata.ld")
   set(rodata_path        "${snippet_base}/snippets-rodata.ld")
@@ -1256,6 +1263,7 @@ function(zephyr_linker_sources location)
     file(WRITE ${ram_sections_path} "")
     file(WRITE ${data_sections_path} "")
     file(WRITE ${rom_start_path} "")
+    file(WRITE ${pre_text_sections_path} "")
     file(WRITE ${noinit_path} "")
     file(WRITE ${rwdata_path} "")
     file(WRITE ${rodata_path} "")
@@ -1280,6 +1288,8 @@ function(zephyr_linker_sources location)
     set(snippet_path "${data_sections_path}")
   elseif("${location}" STREQUAL "ROM_START")
     set(snippet_path "${rom_start_path}")
+  elseif("${location}" STREQUAL "PRE_TEXT_SECTIONS")
+    set(snippet_path "${pre_text_sections_path}")
   elseif("${location}" STREQUAL "NOINIT")
     set(snippet_path "${noinit_path}")
   elseif("${location}" STREQUAL "RWDATA")
diff --git a/include/zephyr/arch/arm/cortex_m/scripts/linker.ld b/include/zephyr/arch/arm/cortex_m/scripts/linker.ld
index fb26e91c..92166c88 100644
--- a/include/zephyr/arch/arm/cortex_m/scripts/linker.ld
+++ b/include/zephyr/arch/arm/cortex_m/scripts/linker.ld
@@ -146,6 +146,13 @@ SECTIONS
 
 	} GROUP_LINK_IN(ROMSTART_REGION)
 
+/* Located in generated directory. This file is populated by calling
+ * zephyr_linker_sources(PRE_TEXT_SECTIONS ...). Output sections here come
+ * before the text section, so their input patterns take precedence over
+ * its generic *(.text.*).
+ */
+#include <snippets-pre-text-sections.ld>
+
 #ifdef CONFIG_CODE_DATA_RELOCATION
 
 #include <linker_relocate.ld>
